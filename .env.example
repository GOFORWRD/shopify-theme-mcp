# Copy to .env for local shell use, or set these in your Claude Desktop config
# / systemd unit instead. Never commit real values.

# Store handle only — the part before .myshopify.com
SHOPIFY_STORE=my-store

# Absolute path to the local theme directory (the server manages it as a git repo)
THEME_DIR=/absolute/path/to/my-theme

# Theme Access app password (shptka_...). Optional if you use interactive
# `shopify theme list` login instead. Scoped to themes only.
SHOPIFY_CLI_THEME_TOKEN=

# --- Remote (HTTP) mode only ---
# MCP_TRANSPORT=http
# PORT=8787
# Secret path segment, >=16 chars. Generate with: openssl rand -hex 24
# MCP_SECRET=
